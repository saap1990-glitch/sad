{
  "expo": {
    "name": "دفتر المحاسب الذكي",
    "slug": "smart-accountant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "smart-accountant",
    "splash": {
      "backgroundColor": "#0A1128"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartaccountant.app"
    },
    "android": {
      "package": "com.smartaccountant.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-document-picker"
    ]
  }
}
